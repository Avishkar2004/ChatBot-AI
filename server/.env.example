# Server Configuration
PORT=8080
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/chatbot_ai

# Redis Configuration (optional — the server runs without it, with caching and
# the chat hot window disabled)
REDIS_URL=redis://default:your_password@your-host.redns.redis-cloud.com:6379
REDIS_PASSWORD=your_redis_password

# JWT Configuration
# REQUIRED. Production refuses to start without it, and rejects anything under
# 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate_your_own_do_not_ship_this_value
JWT_EXPIRES_IN=7d

# AI API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# How much of a thread is replayed to the model each turn. Bounded by both
# message count and characters so a few long messages cannot blow the budget.
CHAT_CONTEXT_MESSAGES=40
CHAT_CONTEXT_CHARS=24000

# CORS Configuration
CLIENT_ORIGINS=http://localhost:3000,https://your-domain.com

# Where the browser app lives. Used to build password reset links.
APP_URL=http://localhost:3000

# Transactional email (password reset). Without these, reset links are written
# to the server log instead of being delivered.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# Admin-only routes (/api/cache, /api/metrics)
ADMIN_EMAILS=you@example.com

# Optional error relay (Slack-compatible webhook)
ERROR_WEBHOOK_URL=
